OPENAI_API_KEY=your_siliconflow_api_key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=resume_screener

# —— IMAP 邮箱收件（招聘平台简历转发专用邮箱）——
# 取值留空则整个邮箱收件功能关闭，仅保留本地上传
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your_mailbox@qq.com
IMAP_PASSWORD=your_imap_auth_code
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
# 每次同步回溯的邮件天数
IMAP_SEARCH_DAYS=7
# 单次最多处理的邮件数
IMAP_MAX_PER_RUN=50
# 定时轮询间隔（秒），0 表示只允许手动触发
IMAP_POLL_INTERVAL=300